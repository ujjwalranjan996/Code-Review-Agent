# --- Pipeline -----------------------------------------------------------
# Production webhook URL of the n8n workflow (Webhook node → Production URL).
# Leave empty to run the dashboard in sample mode.
N8N_WEBHOOK_URL=https://your-tunnel.trycloudflare.com/webhook/ai-review

# Shared secret between this app and n8n. Must equal REVIEW_SECRET in n8n.
REVIEW_SECRET=change-me-to-a-long-random-string

# Public URL of this app, used as n8n's callback. Optional on Vercel.
APP_URL=https://your-app.vercel.app

# --- Access -------------------------------------------------------------
# Anyone opening the dashboard must enter this. Leave empty to disable (local only!).
APP_PASSWORD=

# --- Storage (Upstash Redis via the Vercel Marketplace) -----------------
# Vercel sets these automatically when you add the Upstash integration.
# Without them, reviews are kept in memory and vanish on redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
